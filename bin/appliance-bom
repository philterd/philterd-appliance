#!/usr/bin/env python3
"""Read bom.yaml and act on it.

Components marked `source: registry` are pulled. Those marked `source: build`
are built locally and tagged with the name they will carry once published, so
compose can refer to every component the same way regardless of tier.

    list         show every component and its tier
    render-env   emit IMG_* assignments for compose to interpolate
    build        build the `source: build` components
    doctor       report which registry components actually resolve
"""

import argparse
import pathlib
import shutil
import subprocess
import sys

import yaml

ROOT = pathlib.Path(__file__).resolve().parent.parent
BOM = ROOT / "bom.yaml"


def load():
    with BOM.open() as handle:
        return yaml.safe_load(handle)


def env_var(name):
    """IMG_ prefixed shell variable for a component name."""
    return "IMG_" + name.upper().replace("-", "_")


def ref(component):
    return f"{component['image']}:{component['version']}"


def select(components, names):
    if not names:
        return components
    by_name = {c["name"]: c for c in components}
    unknown = [n for n in names if n not in by_name]
    if unknown:
        sys.exit(f"unknown component(s): {', '.join(unknown)}")
    return [by_name[n] for n in names]


def build_context(component, source_root):
    """Where to build a component from, preferring a sibling checkout.

    Falls back to the remote git URL, which keeps this repository free of
    submodules and vendored source.
    """
    if "context" in component:
        # From this repository, not a sibling.
        return str(ROOT / component["context"]), "in-repo"

    if "dir" in component:
        sibling = (ROOT / source_root / component["dir"]).resolve()
        if sibling.is_dir():
            return str(sibling), "sibling checkout"

    if "repo" in component:
        ref_ = component.get("ref", "main")
        return f"{component['repo']}#{ref_}", "remote git"

    sys.exit(f"{component['name']}: source is 'build' but no context, dir or repo given")


def cmd_list(bom, args):
    components = bom["components"]
    width = max(len(c["name"]) for c in components)
    for c in components:
        profile = c.get("profile", "core")
        print(f"{c['name']:<{width}}  {c['source']:<8}  {profile:<5}  {ref(c)}")

    builds = [c for c in components if c["source"] == "build"]
    if builds:
        print(
            f"\n{len(builds)} of {len(components)} components are built locally: "
            + ", ".join(c["name"] for c in builds)
        )


def cmd_render_env(bom, args):
    print("# Generated by bin/appliance-bom render-env. Do not edit.")
    print("# Regenerate with `make images`.")
    for c in bom["components"]:
        print(f"{env_var(c['name'])}={ref(c)}")


def cmd_build(bom, args):
    source_root = bom.get("defaults", {}).get("sourceRoot", "..")
    components = [
        c for c in select(bom["components"], args.names) if c["source"] == "build"
    ]

    if not components:
        print("nothing to build: every selected component is published")
        return

    for c in components:
        context, kind = build_context(c, source_root)
        tag = ref(c)
        print(f"\n==> {c['name']}: building {tag} from {kind} ({context})")
        command = ["docker", "build", "-t", tag, context]
        if args.dry_run:
            print("    " + " ".join(command))
            continue
        result = subprocess.run(command)
        if result.returncode != 0:
            sys.exit(f"{c['name']}: build failed")


def cmd_doctor(bom, args):
    if not shutil.which("docker"):
        sys.exit("docker not found on PATH")

    ok = True
    for c in bom["components"]:
        tag = ref(c)
        if c["source"] == "registry":
            probe = subprocess.run(
                ["docker", "manifest", "inspect", tag],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            if probe.returncode == 0:
                print(f"ok       {c['name']}: {tag} resolves")
            else:
                ok = False
                print(f"MISSING  {c['name']}: {tag} does not resolve in the registry")
        else:
            local = subprocess.run(
                ["docker", "image", "inspect", tag],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            state = "built" if local.returncode == 0 else "not built yet"
            print(f"build    {c['name']}: {tag} ({state})")

    if not ok:
        sys.exit("\none or more registry components do not resolve")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("list")
    sub.add_parser("render-env")
    sub.add_parser("doctor")

    build = sub.add_parser("build")
    build.add_argument("names", nargs="*", help="components to build (default: all)")
    build.add_argument("--dry-run", action="store_true")

    args = parser.parse_args()
    bom = load()

    {
        "list": cmd_list,
        "render-env": cmd_render_env,
        "build": cmd_build,
        "doctor": cmd_doctor,
    }[args.command](bom, args)


if __name__ == "__main__":
    main()
