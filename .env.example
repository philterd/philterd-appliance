# Copy to .env, or let `make bootstrap` generate one with fresh secrets.
#
# Never commit .env. The two crypto keys below are what the appliance
# encrypts data at rest with; losing or leaking them is a real incident.

# --- secrets ---------------------------------------------------------------
#
# Both must be base64 of exactly 32 random bytes (AES-256). Philter and
# Arbiter each refuse to start without theirs.
#
#   openssl rand -base64 32

PHILTER_ENCRYPTION_KEY=
ARBITER_CRYPTO_SECRET=

# Seeded onto Philter's admin user on first start, and only when that user has
# no API keys yet. Leave empty to skip seeding and mint a key by hand later.
PHILTER_BOOTSTRAP_API_KEY=

# Initial password for Arbiter's bootstrap admin (admin@philterd.ai). Used only
# when no admin account exists. Minimum 12 characters.
ARBITER_ADMIN_INITIAL_PASSWORD=

# --- tls -------------------------------------------------------------------
#
# Mounted into the proxy. `make bootstrap` generates a self-signed certificate
# covering localhost, this host's name and its routable addresses, and points
# these at it.
#
# To use certificates of your own, either set absolute paths here or re-run
# bootstrap with --cert and --key. The nginx configuration does not change
# either way; only the bind-mount source does.

APPLIANCE_TLS_CERT=./proxy/tls/appliance.crt
APPLIANCE_TLS_KEY=./proxy/tls/appliance.key

# --- host ports ------------------------------------------------------------
#
# Only the proxy binds to the host. Philter, PhEye, MongoDB and OpenSearch stay
# on the internal network, so there is one TLS termination point.
#
# Philter, Arbiter and the policy editor all listen on 8080 inside their own
# containers, so the appliance fronts each on a distinct host port. Philter 4.0
# serves its API and its Vaadin dashboard together, so it needs only one.
#
# Every port below is HTTPS, using the appliance's internal certificate
# authority.

APPLIANCE_PORT=8443
PHILTER_PORT=8444
POLICY_EDITOR_PORT=8445
ARBITER_PORT=8446
PHILTERSCOPE_PORT=8447

# --- local llm -------------------------------------------------------------
#
# Ollama runs under the full profile and is shared by Philter Scope's --ai
# policy suggestions and Arbiter's LLM-as-a-Judge. Nothing leaves the machine.
#
# The model is downloaded on first start of the full profile. This drives both
# the pull and the model Philter Scope asks for, so the two cannot drift apart.
# gemma3:4b is about 3 GB. gemma4 is larger and better at about 9 GB.

OLLAMA_MODEL=gemma3:4b

# --- philter scope ---------------------------------------------------------
#
# Privacy mode obfuscates PII in the evaluation UI. On by default, since an
# appliance holds real data. Set to false to see unmasked values while tuning
# policies.
PHILTERSCOPE_PRIVACY=true

# Host directory the one-shot audit reads and writes. Expects `golden/` and
# `raw/` subdirectories; the report is written back here.
PHILTERSCOPE_DATA=./data/philterscope

# The audit writes into that host directory, so it runs as the owning user
# rather than as the image's own account. `make bootstrap` fills these in.
APPLIANCE_UID=1000
APPLIANCE_GID=1000
